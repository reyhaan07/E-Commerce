# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/shopsphere
PORT=5000

# Auth
JWT_SECRET=change-this-to-a-random-string

# Where the shared login app runs (used in password-reset email links)
LOGIN_APP_URL=http://localhost:5177

# SMTP (optional — leave unset and all email is logged to the console instead)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="ShopSphere <no-reply@example.com>"

# ── Payments ──────────────────────────────────────────────────────────────
# With no Razorpay credentials the storefront offers Cash on Delivery only:
# the card / UPI options are shown disabled and the API refuses a Prepaid
# order. Add the test keys below and online payment turns on by itself.
#
# ENABLE_MOCK_PAYMENTS=true re-opens the built-in mock checkout without keys.
# Used by the automated payment tests; leave it unset for demos.
# ENABLE_MOCK_PAYMENTS=false

# Razorpay TEST keys (optional — leave unset for Cash on Delivery only).
# Use rzp_test_... keys only; this project never handles live payments.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
